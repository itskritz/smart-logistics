<!-- views/reports.ejs -->

<!DOCTYPE html>
<html>
<head>
    <title>Reports - Smart Logistics</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav>
    <h2>Smart Logistics</h2>
    <a href="/dashboard">Dashboard</a>
    <a href="/routes">Routes</a>
    <a href="/sos">SOS</a>
</nav>

<main class="container">

    <h1>Road Reports</h1>

    <div class="card">
        <h2>Ask Gemini About Reports</h2>

        <form id="assistantForm">
            <input
                id="assistantQuestion"
                type="text"
                placeholder="Are there any blocked roads?"
                required
            >
            <button type="submit">Ask AI</button>
        </form>

        <p id="assistantAnswer"></p>
    </div>

    <% if (user) { %>
        <a class="btn" href="/reports/new">Report a Road Problem</a>
    <% } else { %>
        <a class="btn" href="/login">Login to Report a Road Problem</a>
    <% } %>

    <div class="reports">

        <% if (reports.length === 0) { %>

            <p>No reports available.</p>

        <% } else { %>

            <% reports.forEach(report => { %>

                <div class="card">

                    <h3><%= report.issue_type %></h3>

                    <p>
                        <strong>Severity:</strong>
                        <%= report.severity %>
                    </p>

                    <p>
                        <strong>Status:</strong>
                        <%= report.status %>
                    </p>

                    <p>
                        <%= report.description %>
                    </p>

                    <a href="/reports/<%= report.id %>">
                        View Report
                    </a>

                </div>

            <% }) %>

        <% } %>

    </div>

</main>

<script>
    document
        .getElementById("assistantForm")
        .addEventListener("submit", async event => {
            event.preventDefault();

            const question = document.getElementById("assistantQuestion").value;
            const answerElement = document.getElementById("assistantAnswer");

            answerElement.textContent = "Gemini is analyzing the reports...";

            const response = await fetch("/api/assistant", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ question })
            });

            const data = await response.json();
            answerElement.textContent = data.answer;
        });
</script>

</body>
</html>