<!-- views/dashboard.ejs -->

<!DOCTYPE html>
<html>
<head>
    <title>Dashboard - Smart Logistics</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav>
    <h2>Smart Logistics</h2>
    <a href="/dashboard">Dashboard</a>
    <a href="/routes">Routes</a>
    <a href="/reports">Reports</a>
    <a href="/sos">SOS</a>
    <a href="/logout">Logout</a>
</nav>

<main class="container">

    <h1>Welcome, <%= user.name %></h1>

    <div class="cards">

        <div class="card">
            <h3>Route Planning</h3>
            <p>Find safer and better routes.</p>
            <a href="/routes">Plan Route</a>
        </div>

        <div class="card">
            <h3>Road Reports</h3>
            <p>View and report road problems.</p>
            <a href="/reports">View Reports</a>
        </div>

        <div class="card">
            <h3>Emergency SOS</h3>
            <p>Send an emergency alert.</p>
            <a href="/sos">SOS</a>
        </div>
        

    </div>
     <!-- Add the chart here -->
    <div style="width: 500px; max-width: 100%;">
        <h2>Report Status</h2>
        <canvas id="reportsStatusChart"></canvas>
    </div>

</main>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    fetch("/api/charts/reports-status")
        .then(response => response.json())
        .then(data => {
            const labels = data.map(item => item.status);
            const values = data.map(item => Number(item.total));

            new Chart(document.getElementById("reportsStatusChart"), {
                type: "pie",
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: [
                            "#2563eb",
                            "#16a34a",
                            "#f59e0b",
                            "#dc2626",
                            "#9333ea"
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: "bottom"
                        }
                    }
                }
            });
        });
</script>


</body>
</html>